{
  "name": "shadowgit-mcp-server",
  "version": "2.0.0",
  "description": "MCP server that lets AI assistants read ShadowGit's snapshot history and save their edits as sessions and checkpoints",
  "mcpName": "io.github.aflsolutions/shadowgit",
  "type": "module",
  "bin": {
    "shadowgit-mcp-server": "dist/shadowgit-mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "eval": "npm run build && tsx scripts/eval-docs-phrases.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "ai",
    "claude",
    "cursor",
    "debugging",
    "shadowgit"
  ],
  "author": "Alessandro Afloarei",
  "license": "MIT",
  "homepage": "https://shadowgit.com",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
